# ==========================================
# Veyra File Manager — Production .gitignore
# ==========================================

# --- Rust & Cargo Build Outputs ---
/target/
**/target/
cargo-timing.html
*.rs.bk

# --- SQLite & Search Index Temporary Files ---
*.db
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db-journal

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.*.swp
.*.swo
*~
.helix/
.kate-project*
*.sublime-workspace
*.sublime-project

# --- Linux Desktop & OS Generated Artifacts ---
.DS_Store
Thumbs.db
.directory
.fuse_hidden*
.Trash-*

# --- Temporary Files, Logs & Scratch Artifacts ---
*.log
/scratch/
/tmp/
/temp/
.env
.env.*
!.env.example

# --- Flatpak & Build Tooling ---
.flatpak-builder/
_build/
/build/
/dist/
