# ==========================================
# Veyra File Manager — Production .gitignore
# ==========================================

# --- Rust & Cargo Build Outputs ---
/target/
**/target/
cargo-timing.html
*.rs.bk

# --- Sensitive Data, Keys & Authentication ---
*.pem
*.key
*.p12
*.pfx
*.gpg
*.asc
id_rsa*
id_ed25519*
id_ecdsa*
*.token
*.secret
credentials.json
secrets.*
.env
.env.*
!.env.example

# --- AI Assistants & IDE / Editor Artifacts ---
.claude/
.gemini/
.agents/
.cursor/
.windsurf/
.zed/
.idea/
.vscode/
*.swp
*.swo
.*.swp
.*.swo
*~
.helix/
.kate-project*
*.sublime-workspace
*.sublime-project

# --- Crash Reports, Logs & Diagnostic Data ---
logs/
crashes/
*.log
*.dump
*.crash
*.backtrace
core
core.*
vgcore.*
*.profraw
*.profdata

# --- Database & Search Index Files ---
*.db
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db-journal

# --- Packaging & Temporary Build Artifacts ---
*.tar.gz
*.tar.xz
*.rpm
*.deb
*.pkg.tar.zst
staging/
build-dir/
_build/
/build/
/dist/
.flatpak-builder/

# --- OS & Desktop Metadata Files ---
.DS_Store
Thumbs.db
.directory
.fuse_hidden*
.Trash-*
.thumbnails/

# --- Temporary Files & Scratch Artifacts ---
/scratch/
/tmp/
/temp/
