# Maintainer: Veyra Contributors
pkgname=veyra
pkgver=1.1.0
pkgrel=1
pkgdesc="Modern, high-performance Linux file manager built with Rust, GTK4 and Libadwaita"
arch=('x86_64' 'aarch64')
url="https://github.com/ERAYQ1/Veyra-File-Manager"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'glib2')
makedepends=('cargo' 'rust')
optdepends=(
	'polkit: Privileged operations escalation'
	'gvfs: Network and remote mounts'
	'xdg-terminal-exec: System default terminal'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "Veyra-File-Manager-$pkgver"
	cargo fetch --locked
}

build() {
	cd "Veyra-File-Manager-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release --workspace
}

package() {
	cd "Veyra-File-Manager-$pkgver"
	make DESTDIR="$pkgdir" PREFIX=/usr install
}
